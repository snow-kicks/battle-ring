# ==================================
# Battle Ring — Configuração
# ==================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# O arquivo .env fica só no seu computador. NUNCA envie para o GitHub nem cole em conversas.

# Porta do servidor (padrão: 3000)
PORT=3000

# Usuário do TikTok (sem @), usado para conectar automático ao ligar
TIKTOK_USERNAME=seu_usuario
AUTO_CONNECT=false

# EulerStream (obrigatório só para conectar numa live real)
# Chave grátis em: https://www.eulerstream.com/
EULER_API_KEY=sua_chave_euler

# ----- Narrador com voz (opcional) -----
# 1) Quem escreve as falas: Claude (Anthropic) OU OpenAI. Preencha um dos dois.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# LLM_PROVIDER=anthropic

# 2) Quem fala em voz alta: ElevenLabs
ELEVENLABS_API_KEY=
# Voz do narrador. Padrão: Adam (grave, de narrador). Para trocar, copie o ID de outra voz no ElevenLabs.
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# 3) Modo e limite do narrador (teste)
# NARRATOR_MODE=misto   (misto = falas prontas + Claude nas especiais | fixo = só falas prontas, sem Claude | ia = sempre Claude)
# ELEVENLABS_BUDGET_USD=1   (limite de gasto ESTIMADO do ElevenLabs. Ao chegar nele o narrador desliga)
# ELEVENLABS_USD_PER_1K_CHARS=0.30   (preço usado na estimativa; ajuste ao seu plano)
