# ==================================================================
# Battle Ring: todas as opções do .env
# ==================================================================
# Copie este arquivo para .env:   cp .env.example .env
# O .env fica só no seu computador. NUNCA envie para o GitHub nem cole em conversas.
# Linhas com # na frente estão DESLIGADAS (usam o valor padrão).
# Para ativar uma opção: tire o # do começo, sem espaços e sem aspas. Depois reinicie o servidor.

# ---------- Servidor ----------
# PORT=3000                       # porta do servidor (padrão 3000)

# ---------- TikTok ----------
# TIKTOK_USERNAME=seu_usuario     # usuário da live, sem @ (se vazio, você digita na tela)
# AUTO_CONNECT=false              # true = conecta sozinho ao ligar
# EULER_API_KEY=                  # chave do EulerStream (só para live real). Grátis em eulerstream.com
# TIKTOK_SESSION_ID=              # avançado: cookie de sessão do TikTok (só se precisar)
# TIKTOK_TARGET_IDC=              # avançado: região do TikTok (só se precisar)

# ---------- Narrador: quem fala em voz alta ----------
# ELEVENLABS_API_KEY=             # chave do ElevenLabs (sem ela o narrador não funciona)
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # voz do narrador. Padrão: Adam. Para trocar, copie o ID de outra voz

# ---------- Narrador: modo das falas ----------
# NARRATOR_MODE=0                 # 0 = sem IA, só falas prontas com o nome (mais barato, padrão)
#                                 # 1 = híbrido: prontas, e o Claude escreve vitória, boas-vindas e convite
#                                 # 2 = tudo escrito pelo Claude (mais variado e mais caro)

# NARRATOR_MAX_WORDS=12          # tamanho máximo das falas da IA, em palavras (modos 1 e 2)
# NARRATOR_MAX_CHARS=90          # corte final em letras: se a IA passar disso, o servidor corta a fala

# ---------- Narrador: limite de gasto ----------
# ELEVENLABS_CACHE_ONLY=0        # 1 = só toca falas já salvas no cache, sem gastar nada (para ensaiar)
# ELEVENLABS_BUDGET_USD=1         # limite ESTIMADO em dólares. Ao chegar nele o narrador desliga sozinho
# ELEVENLABS_USD_PER_1K_CHARS=0.30   # preço por mil caracteres, usado na estimativa (ajuste ao seu plano)

# ---------- IA que escreve as falas (só nos modos 1 e 2) ----------
# ANTHROPIC_API_KEY=              # chave do Claude (Anthropic)
# ANTHROPIC_MODEL=claude-haiku-5-5   # modelo do Claude
# OPENAI_API_KEY=                 # alternativa: chave da OpenAI
# LLM_PROVIDER=anthropic          # anthropic ou openai (padrão: Claude se houver chave dele)

# ---------- Acesso e vários anfitriões (avançado, normalmente não precisa) ----------
# ACCESS_PIN=                     # senha única para entrar nas telas de controle
# HOST_PINS=                      # formato: nome:senha:usuario,nome2:senha2:usuario2

# ---------- Banco Supabase (avançado, não usado neste projeto) ----------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
